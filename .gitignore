# Build cache
/target

# Console key material — NEVER commit or share (can derive console-unique keys)
/keys/
boot9.bin
boot11.bin
essentials.bin
movable.sed
seeddb.bin
otp.mem
otp.bin
firm0.bin
firm1.bin

# Dot-prefixed top-level dirs (.Data/, .thirdparty/) are machine-local
# workspace material — "agentic references", not repo content. Everything
# under .Data/ (dumps, extracts, generated C, symbol maps, port trees,
# binaries) derives from the user's own game copies and/or console
# material — commit the READMEs only.
/.Data/**
!/.Data/README.md
!/.Data/update/
!/.Data/update/README.md

# Upstream tool checkouts (same dot rule) — keep only their index + fetch script
/.thirdparty/**
!/.thirdparty/README.md
!/.thirdparty/fetch.sh
!/.thirdparty/reference/
!/.thirdparty/reference/README.md

# Runtime track: our files are tracked; the upstream zakuro clone is not
/xy-runtime/zakuro/

# Ghidra project store (code.bin + all CRO programs, game-derived like .Data/)
# — lives at repo root, not under .Data/, because Ghidra's ProjectLocator
# rejects any dot-prefixed path element (see docs/decomp/ghidra-scripts.md)
/ghidra_project/

# ZCode agent state (machine-local)
/.zcode/

# Exported game assets (GLB/PNG renders etc. are game-derived too)
/exports/

# Python scratch
__pycache__/
*.pyc
